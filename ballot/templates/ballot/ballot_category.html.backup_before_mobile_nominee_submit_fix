{% extends "ballot/base.html" %}
{% load billboard_ads %}

{% block title %}{{ category.name }} | ATL’s Hottest{% endblock %}

{% block content %}

{% if active_campaign and not voting_open %}
  <div class="voting-preview-notice">
    <strong>Voting starts October 4, 2026 and ends November 22, 2026.</strong>
    <span>You may view the current ballot and nominees, but votes cannot be cast until the official voting period begins.</span>
  </div>
{% endif %}

{% render_billboard "voting_top" %}

<section class="hero small ballot-category-hero">
  <p class="eyebrow">{{ category.group|default:"ATL’s Hottest Category" }}</p>
  <h1>{{ category.name }}</h1>

  {% if voting_open %}
    <p>Select one nominee in this category. You can review and change your selections before final submit.</p>
  {% else %}
    <p>Voting is not active yet. You may preview approved nominees in this category.</p>
  {% endif %}

  <div class="ballot-status-row">
    <a class="btn" href="{% url 'ballot' %}">Back to Categories</a>

    {% if voting_open %}
      <a class="btn primary" href="{% url 'ballot_review' %}">Review My Votes</a>
    {% else %}
      <span class="btn disabled-vote-btn">Voting Starts October 4, 2026</span>
    {% endif %}
  </div>
</section>

<section class="card ballot-category-section">
  <div class="section-title-row category-heading-row">
    <div>
      <p class="eyebrow">Nominees</p>
      <h2>{{ category.name }}</h2>
    </div>
    <span class="nominee-count">{{ nominees|length }} nominee{{ nominees|length|pluralize }}</span>
  </div>

  <div class="ballot-category-only-grid">
    {% for nominee in nominees %}
      <article class="ballot-nominee-card nominee-card {% if nominee.id == selected_nominee_id %}selected-nominee-card{% endif %}">
        <a class="nominee-card-link" href="{% url 'nominee_detail' nominee.id %}">
          <div class="nominee-photo-frame">
            {% if nominee.photo %}
              <img src="{{ nominee.photo.url }}" alt="{{ nominee.name }}">
            {% else %}
              <div class="photo-placeholder">ATL</div>
            {% endif %}
          </div>

          <div class="nominee-card-body">
            <h3>{{ nominee.name }}</h3>
            <p>{{ category.name }}</p>

            {% if nominee.id == selected_nominee_id %}
              <strong class="selected-vote-note">Current Selection</strong>
            {% endif %}
          </div>
        </a>

        {% if voting_open %}
          <form method="post" action="{% url 'select_ballot_nominee' category.slug nominee.id %}" class="select-nominee-form">
            {% csrf_token %}
            <button class="btn primary vote-card-btn" type="submit" name="next_action" value="review">
              Select & Review
            </button>
            <button class="btn vote-card-btn" type="submit" name="next_action" value="continue">
              Select & Continue Voting
            </button>
          </form>
        {% else %}
          <a class="btn vote-card-btn" href="{% url 'nominee_detail' nominee.id %}">View Nominee</a>
          <span class="btn disabled-vote-btn">Voting Starts October 4, 2026</span>
        {% endif %}
      </article>
    {% empty %}
      <article class="ballot-nominee-card nominee-card placeholder-card">
        <div class="nominee-photo-frame placeholder-frame">
          <div class="photo-placeholder">ATL</div>
        </div>

        <div class="nominee-card-body">
          <h3>No Nominees Yet</h3>
          <p>{{ category.name }}</p>
        </div>

        <a class="btn vote-card-btn" href="{% url 'nominee_signup' %}">Nominate Someone</a>
      </article>
    {% endfor %}

    {% for item in placeholders %}
      <article class="ballot-nominee-card nominee-card placeholder-card">
        <div class="nominee-photo-frame placeholder-frame">
          <div class="photo-placeholder">ATL</div>
        </div>

        <div class="nominee-card-body">
          <h3>Your Nominee Here</h3>
          <p>{{ category.name }}</p>
        </div>

        <a class="btn vote-card-btn" href="{% url 'nominee_signup' %}">Submit Nomination</a>
      </article>
    {% endfor %}
  </div>
</section>

<section class="ballot-bottom-actions">
  <div class="ballot-status-row">
    <a class="btn" href="{% url 'ballot' %}">Back to Categories</a>

    {% if voting_open %}
      <a class="btn primary" href="{% url 'ballot_review' %}">Continue to Review</a>
    {% else %}
      <span class="btn disabled-vote-btn">Voting Starts October 4, 2026</span>
    {% endif %}
  </div>
</section>

{% endblock %}
