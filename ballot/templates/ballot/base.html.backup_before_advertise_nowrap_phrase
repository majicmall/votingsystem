    }

    .ballot-nominee-card:hover {
      border-color: rgba(255, 215, 106, 0.95) !important;
      box-shadow:
        0 18px 45px rgba(0,0,0,0.62),
        0 0 28px rgba(255, 215, 106, 0.28),
        0 0 48px rgba(215, 25, 53, 0.2) !important;
    }

    .nominee-photo-frame,
    .dashboard-photo-frame,
    .nominee-detail-photo {
      border-color: rgba(255,255,255,0.18) !important;
      background:
        radial-gradient(circle at 50% 12%, rgba(255, 215, 106, 0.18), transparent 40%),
