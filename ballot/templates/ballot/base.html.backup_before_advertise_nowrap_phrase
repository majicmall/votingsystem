      text-shadow: 0 0 14px rgba(255, 215, 106, 0.65) !important;
    }

    .btn.primary,
    button.primary,
    .submit-vote-btn,
    .detail-vote-btn,
    input[type="submit"] {
      color: #160704 !important;
      border-color: rgba(255, 215, 106, 0.98) !important;
      background:
        linear-gradient(135deg, #fff9d6 0%, #ffd76a 35%, #d69628 68%, #8a4a09 100%) !important;
      box-shadow:
        0 0 18px rgba(255, 215, 106, 0.35),
        0 0 34px rgba(255, 215, 106, 0.14),
        inset 0 1px 0 rgba(255,255,255,0.65) !important;
    }

    .btn,
    button,
    .about-btn,
    .see-more-btn {
      color: #ffffff !important;
      border-color: rgba(255,255,255,0.28) !important;
      background:
        linear-gradient(135deg, rgba(255,255,255,0.13), rgba(255,255,255,0.045)) !important;
    }

    .see-more-btn {
      color: #ffd76a !important;
      border-color: rgba(255, 215, 106, 0.72) !important;
      box-shadow: 0 0 18px rgba(255, 215, 106, 0.16) !important;
    }

    input,
    select,
    textarea {
      color: #ffffff !important;
      background: rgba(0,0,0,0.72) !important;
      border-color: rgba(255, 215, 106, 0.32) !important;
    }

    .messages {
      display: grid;
      gap: 16px;
      margin: 0 0 24px;
    }

    .message,
    .alert,
    .result {
      border: 1px solid rgba(255, 215, 106, 0.55) !important;
      border-radius: 20px !important;
      padding: 18px 20px !important;
      color: #ffffff !important;
      background:
        radial-gradient(circle at 10% 0%, rgba(255, 215, 106, 0.18), transparent 38%),
        linear-gradient(135deg, rgba(0,0,0,0.86), rgba(110, 5, 20, 0.75)) !important;
      box-shadow:
        0 0 24px rgba(255, 215, 106, 0.18),
        0 16px 40px rgba(0,0,0,0.45) !important;
    }

    .vote-thank-you-panel {
      position: relative;
      overflow: hidden;
      margin: 0 0 28px;
      padding: clamp(22px, 4vw, 36px);
      border: 1px solid rgba(255, 215, 106, 0.72);
      border-radius: 28px;
      background:
        linear-gradient(145deg, rgba(255,255,255,0.14), rgba(255,255,255,0.035)),
        radial-gradient(circle at 20% 0%, rgba(255, 215, 106, 0.24), transparent 36%),
        linear-gradient(135deg, #000000, #7d0616 58%, #050505);
      box-shadow:
        0 28px 90px rgba(0,0,0,0.66),
        0 0 32px rgba(255, 215, 106, 0.24),
        0 0 58px rgba(215, 25, 53, 0.18);
    }

    .vote-thank-you-panel::before {
      content: "";
      position: absolute;
      inset: 0;
      background: linear-gradient(115deg, transparent 0%, rgba(255,255,255,0.12) 42%, transparent 54%);
      pointer-events: none;
    }

    .vote-thank-you-panel > * {
      position: relative;
      z-index: 1;
    }

    .vote-thank-you-panel h2 {
      margin: 0 0 8px;
      color: #ffffff !important;
      font-size: clamp(2rem, 5vw, 4.2rem);
      line-height: 1;
      text-shadow:
        0 0 10px rgba(255,255,255,0.38),
        0 0 26px rgba(255, 215, 106, 0.62),
        0 0 55px rgba(215, 25, 53, 0.36) !important;
    }

    .vote-thank-you-panel .special-email {
      color: #ffd76a !important;
      font-weight: 1000;
      text-shadow: 0 0 14px rgba(255, 215, 106, 0.45);
    }
  
    /* =========================================================
       ATL'S HOTTEST HEADER BRAND + NAV POLISH
       ========================================================= */

    .site-header {
      position: sticky;
      top: 0;
      z-index: 1000;
      backdrop-filter: blur(18px);
      -webkit-backdrop-filter: blur(18px);
      background:
        linear-gradient(135deg, rgba(0,0,0,0.86), rgba(42, 2, 10, 0.82)),
        rgba(0,0,0,0.82) !important;
      border-bottom: 1px solid rgba(255, 215, 106, 0.28);
      box-shadow:
        0 12px 34px rgba(0,0,0,0.38),
        0 0 24px rgba(255, 215, 106, 0.08);
    }

    .brand {
      position: relative;
      display: inline-flex;
      align-items: center;
      color: #fff !important;
      font-family: "Playfair Display", Georgia, serif !important;
      font-size: clamp(1.25rem, 2.5vw, 2rem) !important;
      font-weight: 1000 !important;
      letter-spacing: -0.045em !important;
      line-height: 1.05;
      text-decoration: none !important;
      text-transform: none !important;
      text-shadow:
        0 0 8px rgba(255,255,255,0.20),
        0 0 18px rgba(255, 215, 106, 0.50),
        0 0 34px rgba(215, 25, 53, 0.26);
    }

    .brand::before {
      content: "";
      width: 18px;
      height: 24px;
      margin-right: 10px;
      display: inline-block;
      flex: 0 0 auto;
      border-radius: 62% 38% 58% 42% / 68% 38% 62% 32%;
      background:
        radial-gradient(circle at 52% 68%, #fff3a6 0 12%, transparent 18%),
        radial-gradient(circle at 48% 60%, #ffd76a 0 24%, transparent 34%),
        linear-gradient(145deg, #ffd76a 0%, #ff8a00 34%, #d71935 68%, #76000f 100%);
      transform: rotate(-9deg);
      box-shadow:
        0 0 8px rgba(255, 215, 106, 0.82),
        0 0 16px rgba(255, 119, 0, 0.42),
        0 0 26px rgba(215, 25, 53, 0.34);
      clip-path: polygon(
        52% 0%,
        72% 22%,
        86% 44%,
        78% 72%,
        58% 100%,
        33% 88%,
        16% 64%,
        23% 38%,
        38% 22%
      );
      animation: atlBrandFlameFlicker 2.6s ease-in-out infinite;
    }

    @keyframes atlBrandFlameFlicker {
      0%, 100% {
        transform: rotate(-9deg) scale(1);
        filter: brightness(1);
      }
      45% {
        transform: rotate(-6deg) scale(1.06);
        filter: brightness(1.18);
      }
      72% {
        transform: rotate(-12deg) scale(0.97);
        filter: brightness(0.96);
      }
    }


    .brand::after {
      content: "";
      position: absolute;
      left: 1.45em;
      right: 8%;
      bottom: -8px;
      height: 2px;
      border-radius: 999px;
      background: linear-gradient(90deg, transparent, #ffd76a, #d71935, transparent);
      box-shadow: 0 0 16px rgba(255, 215, 106, 0.55);
    }

    nav a {
      position: relative;
      overflow: hidden;
      border-radius: 999px !important;
      padding: 9px 15px !important;
      border: 1px solid rgba(255, 215, 106, 0.42) !important;
      background:
        linear-gradient(135deg, rgba(255,255,255,0.12), rgba(255,255,255,0.025)),
        rgba(0, 0, 0, 0.54) !important;
      color: #fff !important;
      font-size: 0.74rem !important;
      font-weight: 950 !important;
      letter-spacing: 0.065em !important;
      text-transform: uppercase !important;
      text-decoration: none !important;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.18),
        0 0 14px rgba(255, 215, 106, 0.10);
      transition:
        transform 180ms ease,
        border-color 180ms ease,
        box-shadow 180ms ease,
        background 180ms ease;
    }

    nav a:hover {
      transform: translateY(-1px);
      border-color: rgba(255, 215, 106, 0.82) !important;
      background:
        linear-gradient(135deg, rgba(255, 215, 106, 0.24), rgba(215, 25, 53, 0.16)),
        rgba(0, 0, 0, 0.74) !important;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.24),
        0 0 22px rgba(255, 215, 106, 0.24),
        0 0 34px rgba(215, 25, 53, 0.12);
    }

    nav a[href*="ballot"] {
      color: #080808 !important;
      border-color: rgba(255, 215, 106, 0.9) !important;
      background:
        linear-gradient(135deg, #fff4b0 0%, #ffd76a 42%, #b67812 100%) !important;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.62),
        0 0 22px rgba(255, 215, 106, 0.30) !important;
    }

    @media (max-width: 760px) {
      .brand {
        font-size: clamp(1rem, 4.7vw, 1.35rem) !important;
      }

      .brand::before {
        margin-right: 6px;
      }

      nav a {
        padding: 8px 12px !important;
        font-size: 0.68rem !important;
      }
    }

  
    /* =========================================================
       ATL'S HOTTEST MOBILE BRAND + NAV FINAL POLISH
       ========================================================= */

    .site-header {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 18px;
      padding: 14px clamp(14px, 3vw, 28px);
    }

    .brand {
      display: inline-grid !important;
      grid-template-columns: auto 1fr;
      align-items: center;
      gap: 10px;
      max-width: min(420px, 48vw);
      text-decoration: none !important;
    }

    .brand::before {
      display: none !important;
      content: none !important;
    }

    .brand::after {
      left: 32px !important;
      right: 0 !important;
      bottom: -7px !important;
    }

    .brand-mark {
      width: 19px;
      height: 26px;
      display: inline-block;
      flex: 0 0 auto;
      border-radius: 62% 38% 58% 42% / 68% 38% 62% 32%;
      background:
        radial-gradient(circle at 52% 68%, #fff3a6 0 12%, transparent 18%),
        radial-gradient(circle at 48% 60%, #ffd76a 0 24%, transparent 34%),
        linear-gradient(145deg, #ffd76a 0%, #ff8a00 34%, #d71935 68%, #76000f 100%);
      transform: rotate(-9deg);
      box-shadow:
        0 0 8px rgba(255, 215, 106, 0.82),
        0 0 16px rgba(255, 119, 0, 0.42),
        0 0 26px rgba(215, 25, 53, 0.34);
      clip-path: polygon(
        52% 0%,
        72% 22%,
        86% 44%,
        78% 72%,
        58% 100%,
        33% 88%,
        16% 64%,
        23% 38%,
        38% 22%
      );
      animation: atlBrandFlameFlicker 2.6s ease-in-out infinite;
    }

    .brand-words {
      display: grid;
      gap: 1px;
      line-height: 0.94;
      text-align: left;
    }

    .brand-line-one {
      color: #ffffff !important;
      font-family: "Playfair Display", Georgia, serif;
      font-size: clamp(1.05rem, 2.3vw, 1.9rem);
      font-weight: 1000;
      letter-spacing: -0.045em;
      white-space: nowrap;
      text-shadow:
        0 0 8px rgba(255,255,255,0.20),
        0 0 18px rgba(255, 215, 106, 0.50),
        0 0 34px rgba(215, 25, 53, 0.26);
    }

    .brand-line-two {
      color: #ffd76a !important;
      font-size: clamp(0.82rem, 1.65vw, 1.12rem);
      font-weight: 950;
      letter-spacing: 0.18em;
      text-transform: uppercase;
      white-space: nowrap;
      text-shadow:
        0 0 10px rgba(255, 215, 106, 0.44),
        0 0 22px rgba(215, 25, 53, 0.18);
    }

    nav {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      flex-wrap: wrap;
      gap: 8px;
    }

    nav a {
      min-height: 36px;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      padding: 8px 13px !important;
      font-size: 0.68rem !important;
      letter-spacing: 0.055em !important;
      white-space: nowrap;
    }

    nav a[href*="advertise"] {
      color: #ffd76a !important;
      border-color: rgba(255, 215, 106, 0.66) !important;
      background:
        linear-gradient(135deg, rgba(215, 25, 53, 0.28), rgba(0,0,0,0.72)),
        rgba(0,0,0,0.72) !important;
      box-shadow:
        inset 0 1px 0 rgba(255,255,255,0.16),
        0 0 18px rgba(215, 25, 53, 0.18),
        0 0 18px rgba(255, 215, 106, 0.10) !important;
    }

    @media (max-width: 900px) {
      .site-header {
        display: grid;
        grid-template-columns: 1fr auto;
        align-items: center;
        gap: 10px;
        padding: 12px 14px;
      }

      .brand {
        max-width: 100%;
        gap: 8px;
      }

      .brand-mark {
        width: 17px;
        height: 23px;
      }

      .brand-line-one {
        font-size: clamp(1rem, 5.2vw, 1.42rem);
      }

      .brand-line-two {
        font-size: clamp(0.72rem, 3.2vw, 0.92rem);
        letter-spacing: 0.13em;
      }

      .mobile-nav-toggle {
        justify-self: end;
      }

      nav {
        grid-column: 1 / -1;
        justify-content: center;
        width: 100%;
        gap: 7px;
        padding-top: 10px;
      }

      nav a {
        min-height: 38px;
        padding: 8px 10px !important;
        font-size: 0.62rem !important;
      }
    }

    @media (max-width: 560px) {
      .site-header {
        padding: 10px 10px 12px;
      }

      .brand {
        grid-template-columns: auto 1fr;
      }

      .brand::after {
        left: 28px !important;
        bottom: -6px !important;
      }

      .brand-mark {
        width: 16px;
        height: 22px;
        margin-top: -1px;
      }

      .brand-line-one {
        font-size: clamp(1rem, 6vw, 1.25rem);
      }

      .brand-line-two {
        font-size: 0.72rem;
        letter-spacing: 0.095em;
      }

      nav {
        display: grid;
        grid-template-columns: repeat(2, minmax(0, 1fr));
      }

      nav a {
        width: 100%;
        min-height: 40px;
        padding: 8px 7px !important;
        font-size: 0.58rem !important;
        letter-spacing: 0.035em !important;
        text-align: center;
      }

      nav a[href*="advertise"] {
        grid-column: 1 / -1;
      }
    }

  </style>

