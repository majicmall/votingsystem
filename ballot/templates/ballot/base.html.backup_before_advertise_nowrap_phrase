  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <link rel="icon" type="image/svg+xml" href="{% static 'ballot/favicon.svg' %}">

  <link rel="stylesheet" href="{% static 'ballot/site.css' %}?v=guided-vote-2026-08-07-6">
  <link rel="stylesheet" href="{% static 'ballot/mobile_force.css' %}?v=mobile-guided-vote-2026-08-07-6">

  <style>
    :root {
      --atl-black: #020202;
      --atl-red: #d71935;
      --atl-deep-red: #650310;
      --atl-gold: #ffd76a;
      --atl-gold-dark: #a7610d;
      --atl-white: #ffffff;
    }

    html,
    body {
      background:
        radial-gradient(circle at 12% 0%, rgba(255, 215, 106, 0.32), transparent 30%),
        radial-gradient(circle at 86% 8%, rgba(215, 25, 53, 0.45), transparent 34%),
        radial-gradient(circle at 50% 100%, rgba(255, 215, 106, 0.14), transparent 35%),
        linear-gradient(135deg, #000000 0%, #160207 40%, #3a0610 62%, #050505 100%) !important;
      color: #ffffff !important;
    }

    body::before {
      content: "";
      position: fixed;
      inset: 0;
      pointer-events: none;
      z-index: 0;
      background:
        linear-gradient(115deg, transparent 0%, rgba(255,255,255,0.08) 42%, transparent 52%),
        radial-gradient(circle at 50% 0%, rgba(255, 215, 106, 0.12), transparent 45%);
      opacity: 0.9;
    }

    .site-header {
      background: linear-gradient(90deg, #000000 0%, #640412 48%, #000000 100%) !important;
      border-bottom: 2px solid rgba(255, 215, 106, 0.75) !important;
      box-shadow:
        0 0 22px rgba(255, 215, 106, 0.28),
        0 0 44px rgba(215, 25, 53, 0.2),
        0 14px 40px rgba(0,0,0,0.55) !important;
    }

    .brand,
    .site-header a,
    nav a {
      color: #ffffff !important;
    }

    .brand {
      text-shadow:
        0 0 8px rgba(255,255,255,0.45),
        0 0 22px rgba(255, 215, 106, 0.75),
        0 0 44px rgba(215, 25, 53, 0.38) !important;
    }

    nav a {
      border: 1px solid rgba(255, 215, 106, 0.35) !important;
      background: rgba(0,0,0,0.28) !important;
    }

    nav a:hover {
      color: #ffd76a !important;
      border-color: rgba(255, 215, 106, 0.85) !important;
      box-shadow: 0 0 18px rgba(255, 215, 106, 0.35) !important;
    }

    main {
      position: relative;
      z-index: 1;
    }

    .hero,
    .card,
    .nominee-card,
    .manager-card,
    .nominee-detail-card,
    .stat-card {
      border-color: rgba(255, 215, 106, 0.45) !important;
      background:
        linear-gradient(145deg, rgba(255,255,255,0.13), rgba(255,255,255,0.035)),
        radial-gradient(circle at 20% 0%, rgba(255, 215, 106, 0.14), transparent 36%),
        linear-gradient(135deg, rgba(0,0,0,0.9), rgba(98, 4, 18, 0.72)) !important;
      box-shadow:
        0 26px 85px rgba(0,0,0,0.65),
        0 0 30px rgba(255, 215, 106, 0.14),
        0 0 50px rgba(215, 25, 53, 0.12),
        inset 0 0 0 1px rgba(255,255,255,0.05) !important;
    }

    .hero h1,
    h1 {
      color: #ffffff !important;
      text-shadow:
        0 0 10px rgba(255,255,255,0.38),
        0 0 28px rgba(255, 215, 106, 0.58),
        0 0 55px rgba(215, 25, 53, 0.38) !important;
    }

    h2,
    .eyebrow,
    .field-label,
    .category-block h2 {
      color: #ffd76a !important;
      text-shadow:
        0 0 12px rgba(255, 215, 106, 0.48),
        0 0 25px rgba(215, 25, 53, 0.24) !important;
    }

    p,
    .muted,
    label,
    span {
      color: rgba(255,255,255,0.84);
    }

    .ballot-nominee-card {
      border-color: rgba(255, 215, 106, 0.46) !important;
      background:
        linear-gradient(160deg, rgba(255,255,255,0.14), rgba(255,255,255,0.035)),
