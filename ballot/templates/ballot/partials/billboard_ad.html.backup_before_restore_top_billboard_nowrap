{% load static %}

{% if ad %}
<section class="mm-billboard mm-billboard-live">
  <a
    class="mm-billboard-link"
    href="{% if ad.destination_url %}{{ ad.destination_url }}{% else %}#{% endif %}"
    {% if ad.destination_url %}target="_blank" rel="noopener noreferrer"{% endif %}
    aria-label="{{ ad.title }}"
  >

    <div class="mm-billboard-image-wrap">
      {% if ad.image %}
        <img class="mm-billboard-creative-img" src="{{ ad.image.url }}" alt="{{ ad.title }}">
      {% else %}
        <img class="mm-billboard-creative-img" src="{% static 'ballot/img/atls_hottest_billboard_1.png' %}" alt="{{ ad.title }}">
      {% endif %}
    </div>

    <div class="mm-billboard-copy">
      <span class="mm-billboard-label">Sponsored Billboard</span>

      <h2 class="mm-billboard-title"><span class="top-billboard-title-nowrap">{{ ad.title }}</span></h2>

      {% if ad.subtitle %}
        <p>{{ ad.subtitle }}</p>
      {% endif %}

      <div class="mm-billboard-powered">
        Powered By The MajesticMall Megaverse Advertising Platform
      </div>

      {% if ad.call_to_action %}
        <span class="mm-billboard-cta">{{ ad.call_to_action }}</span>
      {% endif %}
    </div>

  </a>
</section>
{% endif %}
